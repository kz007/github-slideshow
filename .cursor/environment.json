{
  "name": "github-slideshow (Jekyll)",
  "user": "ubuntu",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "install": "bundle config set --local path 'vendor/bundle' && bundle install",
  "terminals": [
    {
      "name": "jekyll-serve",
      "command": "bundle exec jekyll serve --host 0.0.0.0 --port 4000 --livereload"
    }
  ],
  "ports": [
    4000
  ]
}
